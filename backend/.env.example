# Server
PORT=3000
NODE_ENV=development
BACKEND_URL=https://api.example.com

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Authentication (generate a unique value of at least 32 characters)
BETTER_AUTH_SECRET=

# Required in production: server-only OTP for appreview@interi.app
APP_REVIEW_OTP=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Interi <no-reply@example.com>

# AI
OPENAI_API_KEY=

# Subscription verification
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
